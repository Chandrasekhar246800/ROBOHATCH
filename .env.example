# ==============================================================================
# ROBOHATCH ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and supply actual credentials for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Requirements: A reachable PostgreSQL 14+ instance (Local, Docker, Supabase, Neon, or Vercel Postgres).
#
# Connection String Syntax:
# postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?schema=public
#
# Examples:
# - Local PostgreSQL:   "postgresql://postgres:postgres@localhost:5432/robohatch?schema=public"
# - Docker Container:   "postgresql://postgres:postgres@localhost:5432/robohatch?schema=public"
# - Neon / Supabase:    "postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/robohatch?sslmode=require"
#
# Setup Steps:
# 1. Start your local PostgreSQL server or create a cloud PostgreSQL database.
# 2. Run: npm run prisma:validate
# 3. Run: npx prisma migrate dev --name init
# 4. Run: npm run prisma:generate
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/robohatch?schema=public"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION (Auth.js / NextAuth v5)
# ------------------------------------------------------------------------------
# Required for encrypting JWT session cookies and CSRF tokens.
# Generate a secure 32+ character key using one of the following commands:
#   npx auth secret
#   openssl rand -base64 33
AUTH_SECRET="your-auth-secret-min-32-chars-long"

# Canonical base URL of the application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. CLOUDINARY (Media Storage - Planned)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ------------------------------------------------------------------------------
# 4. RAZORPAY (Payment Gateway - Test Mode Only)
# ------------------------------------------------------------------------------
# Test Mode credentials. Key ID must start with "rzp_test_". Live keys ("rzp_live_") are rejected.
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"

# ------------------------------------------------------------------------------
# 5. SELLER TAX & JURISDICTION (GST Origin)
# ------------------------------------------------------------------------------
# Required in production. Valid Indian State or Union Territory name or code (e.g. "Karnataka" or "KA").
# Missing or invalid value halts checkout pricing with SELLER_ORIGIN_UNCONFIGURED.
SELLER_ORIGIN_STATE="Karnataka"
